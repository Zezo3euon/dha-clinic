# ============================================================================
# عيادة الدكتور حاتم عواجة - إعدادات Apache لموقع InfinityFree
# ============================================================================

DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # استثناء الملفات والمجلدات الحقيقية (CSS, JS, Fonts, Images) لتصل للمتصفح مباشرة
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # توجيه طلبات الـ API إلى api/index.php
    RewriteRule ^api/(.*)$ api/index.php?endpoint=$1 [QSA,L]

    # توجيه الروابط النظيفة إلى صفحات HTML
    RewriteRule ^dashboard/?$ index.html [L]
    RewriteRule ^patients/?$ patients.html [L]
    RewriteRule ^appointments/?$ appointments.html [L]
    RewriteRule ^visits/?$ visits.html [L]
    RewriteRule ^prescriptions/?$ prescriptions.html [L]
    RewriteRule ^calculator/?$ calculator.html [L]
    RewriteRule ^backups/?$ backups.html [L]
</IfModule>

# تعيين الترميز ليكون دائماً UTF-8 للعربية
AddDefaultCharset UTF-8
