# ============================================================================
# عيادة الدكتور حاتم عواجة - إعدادات Apache لموقع InfinityFree
# ============================================================================

Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. API Router: توجيه كافة طلبات الـ API إلى api/index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^api/(.*)$ api/index.php?endpoint=$1 [QSA,L]

    # 2. توجيه الروابط النظيفة إلى صفحات HTML المستقلة
    RewriteRule ^dashboard/?$ index.html [L]
    RewriteRule ^patients/?$ patients.html [L]
    RewriteRule ^appointments/?$ appointments.html [L]
    RewriteRule ^visits/?$ visits.html [L]
    RewriteRule ^prescriptions/?$ prescriptions.html [L]
    RewriteRule ^calculator/?$ calculator.html [L]
    RewriteRule ^backups/?$ backups.html [L]
</IfModule>

# حماية ملفات الإعدادات الحساسة
<Files "config.php">
    Order Allow,Deny
    Deny from all
</Files>

# تعيين الترميز الافتراضي ليكون دائماً UTF-8 للعربية
AddDefaultCharset UTF-8
